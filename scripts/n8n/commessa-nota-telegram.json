{
  "name": "MES – Note e scadenze di commessa da Telegram",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "name": "Messaggio Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "webhookId": "",
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram bot (da configurare)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Solo le chat autorizzate. Stabilisce il comando e lascia allo Switch il resto.\n//   /nota <commessa> ...   oppure   <commessa> ...   -> comando \"nota\"\n//   /altro ...                                          -> comando \"altro\" (lo Switch lo ignora finché non c'è un ramo)\n// Il resto viene scartato in silenzio: altre chat, testo che non inizia con un numero di commessa.\nconst CHAT_AUTORIZZATE = [CAMBIA_CHAT_ID_1, CAMBIA_CHAT_ID_2]; // interi, i gruppi sono negativi\n\nconst m = $input.first().json.message;\nif (!m || !m.text || !CHAT_AUTORIZZATE.includes(m.chat.id)) return [];\n\nconst autore = [m.from.first_name, m.from.last_name].filter(Boolean).join(' ') || 'Telegram';\nconst testo = m.text.trim();\n\nconst cmd = testo.match(/^\\/(\\w+)(?:@\\w+)?\\s*([\\s\\S]*)$/);\nlet comando, messaggio;\nif (cmd) {\n  comando = cmd[1].toLowerCase();\n  messaggio = cmd[2];\n} else if (/^\\d[\\w-]*(\\s|$)/.test(testo)) { // senza \"/\": deve iniziare con un numero di commessa (25387, 24-081)\n  comando = 'nota';\n  messaggio = testo;\n} else {\n  return [];\n}\nreturn [{ json: { chatId: m.chat.id, comando, messaggio, autore } }];"
      },
      "name": "Chat autorizzate e comando",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cmd-nota",
                    "leftValue": "={{ $json.comando }}",
                    "rightValue": "nota",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "nota"
            }
          ]
        },
        "options": {}
      },
      "name": "Comando",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://mes.modar.cloud/api/webhooks/commessa-nota",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "CAMBIA_COMMESSA_NOTA_WEBHOOK_SECRET"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaggio: $json.messaggio, autore: $json.autore }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Registra nel MES",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Chat autorizzate e comando').item.json.chatId }}",
        "text": "={{ $json.risposta || '⚠️ Il MES non ha risposto' }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "name": "Rispondi in chat",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram bot (da configurare)"
        }
      }
    }
  ],
  "connections": {
    "Messaggio Telegram": {
      "main": [
        [
          {
            "node": "Chat autorizzate e comando",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chat autorizzate e comando": {
      "main": [
        [
          {
            "node": "Comando",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Comando": {
      "main": [
        [
          {
            "node": "Registra nel MES",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Registra nel MES": {
      "main": [
        [
          {
            "node": "Rispondi in chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Rome"
  }
}