{
  "name": "MES – Notifica kit ferramenta pronto (email)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ferramenta-notifiche",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook MES",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "mes-ferramenta-notifiche"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.evento }}",
              "rightValue": "kit_pronto",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "name": "È kit_pronto?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "MES <CAMBIA_MITTENTE@tuodominio.it>",
        "toEmail": "noventa@modar.it",
        "subject": "={{ $json.body.tipo_kit === 'commessa' ? 'Kit ferramenta pronto – ' + $json.body.titolo : 'Kit ferramenta pronto – ODP ' + $json.body.odp }}",
        "emailFormat": "html",
        "html": "={{ $json.body.tipo_kit === 'commessa'\n ? '<p>Il kit ferramenta della commessa <b>' + $json.body.titolo + '</b> è pronto (' + $json.body.righe + ' righe).</p><p><a href=\"' + $json.body.url + '\">Apri il kit</a></p>'\n : '<p>Il kit ferramenta per l\\'ODP <b>' + $json.body.odp + '</b> (scheda ' + $json.body.numero_scheda + ') è pronto (' + $json.body.righe + ' righe).</p><p><a href=\"' + $json.body.pdf_url + '\">Scarica il PDF del kit</a></p>' }}",
        "options": {}
      },
      "name": "Email magazziniere",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        480,
        -80
      ],
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP (da configurare)"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "MES <CAMBIA_MITTENTE@tuodominio.it>",
        "toEmail": "noventa@modar.it",
        "subject": "={{ 'Sotto scorta ferramenta – ' + $json.body.descrizione }}",
        "emailFormat": "html",
        "html": "={{ '<p>L\\'articolo <b>' + $json.body.descrizione + '</b>' + ($json.body.codice_os1 ? ' (cod. ' + $json.body.codice_os1 + ')' : '') + ' è sceso sotto la soglia minima.</p><ul><li>Giacenza attuale: <b>' + $json.body.giacenza_attuale + '</b></li><li>Soglia minima: ' + $json.body.soglia_minima + '</li></ul>' }}",
        "options": {}
      },
      "name": "Email sotto soglia",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        60
      ],
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP (da configurare)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
